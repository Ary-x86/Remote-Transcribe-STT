# ---- Required -------------------------------------------------------------
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# ---- Optional -------------------------------------------------------------
# Unlocks real (acoustic) speaker diarization via ElevenLabs Scribe v2.
# Leave blank and the app falls back to LLM-estimated speaker labels.
ELEVENLABS_API_KEY=

# Shared password for the login gate. Leave BLANK to disable auth entirely
# (only do that on localhost / a private network).
APP_PASSWORD=

# Leave blank and one is generated on first run and stored in DATA_DIR.
SESSION_SECRET=

# ---- Tuning ---------------------------------------------------------------
DEFAULT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b

# Groq upload cap: 25 MB free tier, 100 MB dev tier. Stay a little under.
MAX_UPLOAD_BYTES=24000000

CHUNK_TARGET_SECONDS=600
CHUNK_OVERLAP_SECONDS=2
MAX_CONCURRENT_CHUNKS=3

KEEP_AUDIO=true
HISTORY_RETENTION_DAYS=30
DATA_DIR=./data
